# Конфигурация Google Calendar to Lotus Notes Sync

# Общие настройки приложения
app:
  name: "Google Calendar to Lotus Notes Sync"
  version: "1.0.0"
  log_level: "INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Настройки синхронизации
sync:
  # Направление: google-to-lotus, lotus-to-google, bidirectional
  direction: "bidirectional"
  
  # Интервал автоматической синхронизации (минуты)
  interval_minutes: 15
  
  # Размер пакета для обработки событий
  batch_size: 100
  
  # Стратегия разрешения конфликтов
  # Варианты: manual, google_wins, lotus_wins, latest_wins, merge
  conflict_resolution: "latest_wins"
  
  # Фильтры событий
  filters:
    # Синхронизировать события за последние N дней
    sync_past_days: 7
    
    # Синхронизировать события на N дней вперед
    sync_future_days: 365
    
    # Исключить события "весь день"
    exclude_all_day_events: false
    
    # Исключить события, от которых вы отказались
    exclude_declined_events: true
    
    # Минимальная длительность события (минуты), 0 = без ограничений
    min_event_duration_minutes: 0
    
    # Синхронизировать только эти календари (пусто = все)
    calendar_filter: []

# Google Calendar настройки
google:
  # Путь к файлу с credentials из Google Cloud Console
  credentials_file: "config/google_credentials.json"
  
  # Путь для хранения токена авторизации
  token_file: "data/google_token.pickle"
  
  # ID календаря ("primary" для основного)
  calendar_id: "primary"
  
  # API квоты и ограничения
  max_requests_per_minute: 60
  retry_attempts: 3
  retry_delay_seconds: 5
  
  # Временная зона по умолчанию
  default_timezone: "Europe/Moscow"

# Lotus Notes настройки
lotus:
  # Платформа: auto (автоопределение), windows, linux
  platform: "auto"
  
  # Сервер Domino (пусто для локального)
  server: ""
  
  # База данных (пусто для mail.nsf пользователя)
  database: ""
  
  # ID файл (обычно автоматически)
  id_file: ""
  
  # Пароль (лучше через переменную окружения LOTUS_PASSWORD)
  password: ""
  
  # Настройки для Linux (Wine)
  wine_path: "/usr/bin/wine"
  notes_path: "~/.wine/drive_c/Program Files/IBM/Notes"
  
  # Таймауты (секунды)
  connection_timeout: 30
  operation_timeout: 60
  
  # Использовать Domino REST API вместо COM (если доступно)
  use_rest_api: false
  rest_api_url: ""
  rest_api_token: ""

# База данных
database:
  # Путь к SQLite БД
  path: "data/sync.db"
  
  # Автоматическое резервное копирование
  backup_enabled: true
  backup_interval_days: 7
  backup_keep_count: 10
  backup_path: "data/backups"
  
  # Настройки пула соединений
  pool_size: 5
  max_overflow: 10
  pool_timeout: 30

# Логирование
logging:
  # Файл логов
  file: "logs/gcalsync.log"
  
  # Максимальный размер файла (MB)
  max_size_mb: 10
  
  # Количество резервных копий логов
  backup_count: 5
  
  # Формат логов
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  date_format: "%Y-%m-%d %H:%M:%S"
  
  # Использовать цветные логи в консоли
  colored_console: true
  
  # Логирование в syslog (Linux)
  use_syslog: false
  syslog_address: "/dev/log"
  
  # Уровни логирования для отдельных модулей
  module_levels:
    google_adapter: "INFO"
    lotus_adapter: "INFO"
    sync_engine: "INFO"
    database: "WARNING"

# Уведомления (опционально)
notifications:
  enabled: false
  
  # Email уведомления
  email:
    smtp_server: "smtp.gmail.com"
    smtp_port: 587
    use_tls: true
    from_address: "notifications@example.com"
    to_address: "admin@example.com"
    username: ""  # Используйте переменные окружения
    password: ""  # Используйте переменные окружения
  
  # Уведомлять о событиях
  notify_on:
    - errors
    - conflicts
    # - sync_complete
    # - warnings
  
  # Минимальный интервал между уведомлениями (минуты)
  min_notification_interval: 60

# Производительность и оптимизация
performance:
  # Использовать многопоточность
  use_threading: true
  max_workers: 4
  
  # Кеширование
  enable_cache: true
  cache_ttl_seconds: 300
  
  # Пакетная обработка
  batch_create: true
  batch_update: true
  batch_delete: true

# Безопасность
security:
  # Шифровать токены
  encrypt_tokens: true
  encryption_key_file: "data/.encryption_key"
  
  # Валидация SSL сертификатов
  verify_ssl: true
  
  # Хранить пароли в системном хранилище (keyring)
  use_system_keyring: false

# Отладка и диагностика
debug:
  # Режим отладки
  enabled: false
  
  # Сохранять сырые данные API
  save_raw_api_responses: false
  raw_data_path: "data/debug"
  
  # Детальное логирование SQL запросов
  log_sql: false
  
  # Режим dry-run (не выполнять изменения)
  dry_run: false
