# Google Calendar Configuration
GOOGLE_CREDENTIALS_FILE=config/google_credentials.json
GOOGLE_TOKEN_FILE=data/google_token.pickle
GOOGLE_CALENDAR_ID=primary

# Lotus Notes Configuration (if password needed)
LOTUS_PASSWORD=

# Database
DATABASE_PATH=data/sync.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/gcalsync.log

# Email Notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_FROM=notifications@example.com
NOTIFICATION_TO=admin@example.com

# Sync Configuration
SYNC_INTERVAL_MINUTES=15
CONFLICT_RESOLUTION=latest_wins

# Wine Configuration (Linux only)
WINE_PATH=/usr/bin/wine
NOTES_PATH=~/.wine/drive_c/Program Files/IBM/Notes
